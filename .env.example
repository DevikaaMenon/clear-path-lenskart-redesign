# Copy to .env (PowerShell: copy .env.example .env ; bash: cp .env.example .env)
DATABASE_URL="file:./dev.db"
# Used to sign session and CSRF tokens. Change it for anything beyond local demo use.
SESSION_SECRET="change-me-to-a-long-random-string"
# Where prescription uploads are stored. Must be outside /public.
UPLOAD_DIR="./storage/uploads"
