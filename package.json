{
  "name": "clear-path-lenskart-redesign",
  "version": "0.1.0",
  "private": true,
  "description": "Clear Path: an academic UX redesign concept of an eyewear store website. Not affiliated with or endorsed by Lenskart.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "fonts": "node scripts/copy-fonts.mjs",
    "postinstall": "prisma generate && node scripts/copy-fonts.mjs",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test --project=desktop --project=tablet --project=mobile",
    "screenshots": "next build && playwright test --project=screenshots",
    "setup": "node scripts/setup.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-three/fiber": "9.4.0",
    "bcryptjs": "3.0.3",
    "gsap": "3.15.0",
    "motion": "12.43.0",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "three": "0.180.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
